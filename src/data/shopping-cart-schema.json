{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Cart Item Schema",
	"description": "Schema for a single shopping cart item",
	"type": "object",
	"required": ["productId", "category", "quantity", "priceSnapshot"],
	"properties": {
		"productId": {
			"type": "string"
		},
	"quantity": {
		"type": "integer",
		"minimum": 1
	},
	"priceSnapshot": {
		"type": "number",
		"minimum": 0
	  },
	"name": {
		"type": "string"
	},
	"category": {
		"type": "string"
	},
	"thumbnail": {
		"type": "string"
	},
	"addedAt": {
		"type": "string",
		"format": "date-time"
	  }
	},
	"additionalProperties": false
}
